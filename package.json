{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node server/index.mjs",
    "dev:api:skeleton": "node server/skeleton-c-v1.mjs",
    "dev:stack:start": "node scripts/dev-start-all.mjs",
    "dev:stack:stop": "node scripts/dev-stop-all.mjs",
    "dev:stack:status": "node scripts/dev-status-all.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "docs:check-links:all": "node scripts/check-doc-links.mjs --all",
    "risk:check-tenant-fallback": "node scripts/check-tenant-fallback-risk.mjs",
    "risk:update-tenant-fallback-baseline": "node scripts/check-tenant-fallback-risk.mjs --update-baseline",
    "test:smoke:p-admin-modules": "node scripts/p_admin_module_smoke.mjs",
    "dev:full": "node server/index.mjs & vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply:dbjson": "node scripts/apply_dbjson_sql_to_postgres_v1.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "echarts": "^5.6.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
